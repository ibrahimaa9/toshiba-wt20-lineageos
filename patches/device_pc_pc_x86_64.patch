diff --git a/configs/scripts/pc_bt_detect.sh b/configs/scripts/pc_bt_detect.sh
index 52bf3dd..4ca9622 100644
--- a/configs/scripts/pc_bt_detect.sh
+++ b/configs/scripts/pc_bt_detect.sh
@@ -78,6 +78,15 @@ case "$1" in
         log "Bluetooth forced off (androidboot.bluetooth)"
         ;;
     *)
+        # Toshiba (toshiba_bluetooth ACPI driver, e.g. Portege WT20-B): the adapter's USB
+        # device is powered only after an rfkill unblock, so pulse the switch first
+        if ! has_bluetooth; then
+            for r in /sys/class/rfkill/rfkill*; do
+                [ "$(cat $r/name 2>/dev/null)" = "Toshiba Bluetooth" ] || continue
+                echo 1 > $r/soft && sleep 0.5 && echo 0 > $r/soft
+                log "pulsed ${r##*/} (Toshiba Bluetooth) to power the adapter"
+            done
+        fi
         found=0
         waited=0
         stable=0
diff --git a/configs/scripts/pc_create_partition_table.sh b/configs/scripts/pc_create_partition_table.sh
index 1e683e0..db85a31 100644
--- a/configs/scripts/pc_create_partition_table.sh
+++ b/configs/scripts/pc_create_partition_table.sh
@@ -7,24 +7,39 @@
 #
 # $1: sgdisk executable
 # $2: disk name (e.g. nvme0n1, sda, mmcblk0)
-# $3: 1 to erase the disk, 0 to keep an existing LineageOS layout and its data
+# $3: 1 to erase the disk, 0 to keep an existing LineageOS layout and its data, 2 to install
+#     next to the system already on the disk (dual boot, see below)
 # $4: ro.build.ab_update
 #
 # The partition numbers match virt-common's A/B layout (partitions 1-11, which GRUB and the
-# fstab rely on) plus userdata as partition 12, which takes the rest of the disk.
+# SELinux file contexts rely on) plus userdata as partition 12, which takes the rest of the disk.
 # SUPER_SIZE must match BOARD_SUPER_PARTITION_SIZE in BoardConfig.mk.
+#
+# Dual boot (mode 2, WT20 apply20a): the same partitions, in the same order, go into the largest
+# free block of a GPT disk that already holds another system (Windows), as GPT entries 21-33:
+# the usual number plus DUAL_BASE. Nothing that exists is moved, resized or deleted, and the
+# other system's EFI system partition is not written to: LineageOS gets its own (entry 21, a
+# plain Linux-type partition, so neither the firmware nor Windows picks it up by itself). The
+# free block has to be made beforehand, by shrinking a partition from the other system.
 
+# Android's sgdisk only takes the long options (its popt is a getopt_long wrapper without a short
+# option string): --info=N, not -i N.
 SGDISK_EXEC=$1
 DISK_NAME=$2
 ERASE=$3
 AB_OTA_UPDATER=$4
 
 EFI_SIZE=256M
-SUPER_SIZE=4G
+SUPER_SIZE=10G
 
 # 12 GB in 512-byte sectors (pc_install_disk_select's kMinDiskBytes)
 MIN_DISK_SECTORS=23437500
 
+# Dual boot: offset of the GPT entry numbers, and the smallest free block to install into
+# (24 GiB in 512-byte sectors: 11 GiB of system partitions and at least 13 GiB of userdata)
+DUAL_BASE=20
+MIN_DUAL_SECTORS=50331648
+
 # Level 6 stays off the screen (loglevel=3 on the kernel command line), level 2 shows up
 log() {
     echo "<6>pc_install: $*" > /dev/kmsg
@@ -42,9 +57,24 @@ fail() {
     exit 1
 }
 
-has_lineage_layout() { # disk
-    $SGDISK_EXEC -i 2 /dev/block/$1 2>/dev/null | grep -q "Partition name: 'super'" &&
-        $SGDISK_EXEC -i 12 /dev/block/$1 2>/dev/null | grep -q "Partition name: 'userdata'"
+has_lineage_layout() { # disk, entry number offset (0, or DUAL_BASE)
+    $SGDISK_EXEC --info=$(( $2 + 2 )) /dev/block/$1 2>/dev/null | grep -q "Partition name: 'super'" &&
+        $SGDISK_EXEC --info=$(( $2 + 12 )) /dev/block/$1 2>/dev/null | grep -q "Partition name: 'userdata'"
+}
+
+part_name() { # entry number: prints the partition's GPT name, nothing if the entry is empty
+    $SGDISK_EXEC --info=$1 $TARGET 2>/dev/null | sed -n "s/^Partition name: '\(.*\)'\$/\1/p"
+}
+
+part_exists() { # entry number
+    $SGDISK_EXEC --info=$1 $TARGET 2>/dev/null | grep -q "^Partition unique GUID"
+}
+
+log_table() { # title
+    log "$1"
+    $SGDISK_EXEC --print $TARGET 2>/dev/null | while read -r line; do
+        log "  $line"
+    done
 }
 
 [ -x "$SGDISK_EXEC" ] || fail "sgdisk not found"
@@ -57,6 +87,9 @@ TARGET=/dev/block/$DISK_NAME
 [ "$(cat /sys/block/$DISK_NAME/size)" -ge "$MIN_DISK_SECTORS" ] || fail "$DISK_NAME is smaller than 12 GB"
 log "install disk: $DISK_NAME ($(( $(cat /sys/block/$DISK_NAME/size) / 2097152 )) GiB)"
 
+# Entry number offset of the layout this run works on
+BASE=0
+
 # vendor.create_partition_table.start is left unset: in init.recovery.virt.rc it starts
 # preinstall_check, which only knows the VM disk and GPU layout.
 
@@ -78,14 +111,89 @@ if [ "$ERASE" = "1" ]; then
     # which takes the rest of the disk
     $SGDISK_EXEC --new=13:0:+8M --typecode=13:0700 --change-name=13:pc_logs $TARGET
     $SGDISK_EXEC --new=12:0:0 --change-name=12:userdata $TARGET
-elif has_lineage_layout $DISK_NAME; then
+elif [ "$ERASE" = "2" ]; then
+    BASE=$DUAL_BASE
+    disk_sectors=$(cat /sys/block/$DISK_NAME/size)
+    # The shell's arithmetic is 32-bit, and the sector numbers below are computed with it
+    [ "$disk_sectors" -lt 2000000000 ] || fail "$DISK_NAME is too large for a dual-boot install"
+    [ "$(cat /sys/block/$DISK_NAME/queue/logical_block_size)" = "512" ] ||
+        fail "$DISK_NAME does not have 512-byte sectors"
+    $SGDISK_EXEC --print $TARGET 2>/dev/null | grep -q " EF00 " ||
+        fail "$DISK_NAME has no EFI system partition: there is no UEFI system to install next to"
+    log_table "partition table of $DISK_NAME before the dual-boot install:"
+
+    if has_lineage_layout $DISK_NAME $BASE; then
+        super_sectors=$($SGDISK_EXEC --info=$(( BASE + 2 )) $TARGET | sed -n 's/^Partition size: \([0-9]*\) sectors.*/\1/p')
+        [ "$super_sectors" = "$(( ${SUPER_SIZE%G} * 2097152 ))" ] ||
+            fail "$DISK_NAME has an older dual-boot LineageOS layout; delete its partitions (entries 21-33) first"
+        log "$DISK_NAME already has the dual-boot LineageOS layout: installing over it, its Android data is erased"
+    else
+        for n in $(seq $(( BASE + 1 )) $(( BASE + 13 ))); do
+            if part_exists $n; then
+                fail "GPT entry $n of $DISK_NAME is in use"
+            fi
+        done
+        # /dev/block/by-name must lead to the new partitions: a partition of the other system
+        # that carries one of their names gets a prefix (its name means nothing to Windows)
+        for n in $(seq 1 $BASE); do
+            name=$(part_name $n)
+            case "$name" in
+                EFI|super|misc|persist|metadata|firmware|vendor_boot_a|vendor_boot_b|boot_a|boot_b|BIOS|userdata|pc_logs)
+                    log "renaming partition $n ('$name') to 'other_$name'"
+                    $SGDISK_EXEC --change-name=$n:other_$name $TARGET > /dev/null ||
+                        fail "could not rename partition $n"
+                    ;;
+            esac
+        done
+
+        first=$($SGDISK_EXEC --first-aligned-in-largest $TARGET 2>/dev/null | tail -n 1)
+        last=$($SGDISK_EXEC --end-of-largest $TARGET 2>/dev/null | tail -n 1)
+        case "$first$last" in
+            ''|*[!0-9]*) fail "could not find the free space on $DISK_NAME" ;;
+        esac
+        # Whole MiBs only
+        first=$(( (first + 2047) / 2048 * 2048 ))
+        last=$(( (last + 1) / 2048 * 2048 - 1 ))
+        free=$(( last - first + 1 ))
+        [ "$free" -ge "$MIN_DUAL_SECTORS" ] ||
+            fail "the largest free block of $DISK_NAME is $(( free / 2048 )) MiB: shrink a partition to leave at least $(( MIN_DUAL_SECTORS / 2097152 )) GiB unallocated"
+        log "installing into $(( free / 2048 )) MiB of free space (sectors $first-$last)"
+
+        # One sgdisk run, so the table is written once: every partition right after the
+        # previous one, userdata up to the end of the block
+        args=
+        next=$first
+        add() { # number, name, size in MiB
+            args="$args --new=$1:$next:$(( next + $3 * 2048 - 1 )) --typecode=$1:8300 --change-name=$1:$2"
+            next=$(( next + $3 * 2048 ))
+        }
+        add $(( BASE + 1 )) EFI ${EFI_SIZE%M}
+        add $(( BASE + 2 )) super $(( ${SUPER_SIZE%G} * 1024 ))
+        add $(( BASE + 3 )) misc 1
+        add $(( BASE + 4 )) persist 16
+        add $(( BASE + 5 )) metadata 32
+        add $(( BASE + 6 )) firmware 128
+        add $(( BASE + 7 )) vendor_boot_a 100
+        add $(( BASE + 8 )) vendor_boot_b 100
+        add $(( BASE + 9 )) boot_a 80
+        add $(( BASE + 10 )) boot_b 80
+        add $(( BASE + 11 )) BIOS 4
