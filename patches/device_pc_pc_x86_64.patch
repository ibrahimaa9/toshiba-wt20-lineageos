+/sys/bus/iio/devices/iio:device*  scan_elements/in_incli_x_en                      0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_incli_y_en                      0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_incli_z_en                      0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_rot_from_north_magnetic_tilt_comp_en 0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_rot_quaternion_en               0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_illuminance_en                  0660  system  system
+/sys/bus/iio/devices/iio:device*  scan_elements/in_intensity_both_en               0660  system  system
+/sys/bus/iio/devices/iio:device*  in_accel_sampling_frequency                      0660  system  system
+/sys/bus/iio/devices/iio:device*  in_anglvel_sampling_frequency                    0660  system  system
+/sys/bus/iio/devices/iio:device*  in_magn_sampling_frequency                       0660  system  system
+/sys/bus/iio/devices/iio:device*  in_rot_sampling_frequency                        0660  system  system
+/sys/bus/iio/devices/iio:device*  in_incli_sampling_frequency                      0660  system  system
+/sys/bus/iio/devices/iio:device*  in_illuminance_sampling_frequency                0660  system  system
+/sys/bus/iio/devices/iio:device*  in_intensity_sampling_frequency                  0660  system  system
+/sys/bus/iio/devices/iio:device*  in_accel_hysteresis                              0660  system  system
+/sys/bus/iio/devices/iio:device*  in_anglvel_hysteresis                            0660  system  system
+/sys/bus/iio/devices/iio:device*  in_magn_hysteresis                               0660  system  system
+/sys/bus/iio/devices/iio:device*  in_rot_hysteresis                                0660  system  system
