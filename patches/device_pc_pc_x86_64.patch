diff --git a/BoardConfig.mk b/BoardConfig.mk
index 077c573..2907b3e 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -21,7 +21,7 @@ include device/virt/virt-common/BoardConfigVirtCommon.mk
 # Partitions
 # virt-common's A/B super is 12 GB. The dynamic partitions need about 3 GB, so keep super
 # small and leave the rest of the disk to userdata. Must match pc_create_partition_table.sh.
-BOARD_SUPER_PARTITION_SIZE := 4294967296 # 4 GB
+BOARD_SUPER_PARTITION_SIZE := 10737418240 # 10 GB (WT20: room for GApps and updates)
 BOARD_VIRT_DYNAMIC_PARTITIONS_SIZE := $(shell expr $(BOARD_SUPER_PARTITION_SIZE) - 4194304 )
 $(call soong_config_set,VIRT_PREINSTALL_CHECK,SUPER_PARTITION_SIZE,$(BOARD_SUPER_PARTITION_SIZE))
 # virt-common's 2048 inodes don't hold the firmware (vendor/pc/firmware: GPU, Wi-Fi and
@@ -127,7 +127,8 @@ TARGET_KERNEL_ARCH := x86
 TARGET_KERNEL_CONFIG_EXT += \
     $(DEVICE_PATH)/configs/kernel/vm.config \
     $(DEVICE_PATH)/configs/kernel/pc.config \
-    $(DEVICE_PATH)/configs/kernel/cherrytrail.config
+    $(DEVICE_PATH)/configs/kernel/cherrytrail.config \
+    device/pc/wt20/wt20.config
 
 # Pre-install checks (virt-common's checker is VM specific; pc_create_partition_table.sh
 # does the checks for this target)
@@ -150,3 +151,54 @@ SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += \
 # VINTF
 DEVICE_MANIFEST_FILE += \
     $(DEVICE_PATH)/configs/vintf/manifest.xml
+
+# Toshiba Portege WT20-B (device/pc/wt20)
+# SELinux: labels for the sensor hub's IIO devices
+BOARD_VENDOR_SEPOLICY_DIRS += device/pc/wt20/sepolicy
+# ARM apps through Google's ARM64-to-x86_64 translator (options.mk: WT20_ARM_TRANSLATION): arm64-v8a
+# in the ABI list, the SELinux rules for its binfmt_misc handlers
+ifeq ($(WT20_ARM_TRANSLATION),true)
+include vendor/google/ndk_translation/BoardConfigNdkTranslation.mk
+endif
+# Only the modules this tablet uses: the Intel GPU and Wi-Fi (iwlwifi 7265) besides
+# virt-common's btusb / cfg80211 / virt_wifi. The other GPU and Wi-Fi drivers stay on
+# /vendor but aren't loaded at boot (67 modules, RAM and boot time on 4 GB).
+BOARD_VENDOR_KERNEL_MODULES_LOAD := \
+    btusb.ko \
+    cfg80211.ko \
+    virt_wifi.ko \
+    i915.ko \
+    iwlwifi.ko \
+    iwlmvm.ko
+
+# Toshiba Portege WT20-B: Intel RAPL powercap driver (device/pc/wt20/options.mk: WT20_RAPL)
+ifeq ($(WT20_RAPL),true)
+TARGET_KERNEL_CONFIG_EXT += device/pc/wt20/wt20-rapl.config
+endif
+
+# Toshiba Portege WT20-B: SELinux for its thermal HAL (device/pc/wt20/options.mk: WT20_THERMAL_HAL)
+ifeq ($(WT20_THERMAL_HAL),true)
+BOARD_VENDOR_SEPOLICY_DIRS += device/pc/wt20/thermal/sepolicy
+endif
+
+# WT20_WIFI_STA_AP (device/pc/wt20/options.mk, apply15p): AIDL Wi-Fi HAL with the emulators'
+# generic nl80211 legacy HAL (no vendor commands; uses the wlan0 / wlan1 that exist) and the
+# 7265's combinations: (1 STA + 1 P2P) or (1 STA + 1 AP, same channel, iwlwifi mvm)
+ifeq ($(WT20_WIFI_STA_AP),true)
+BOARD_WLAN_DEVICE := emulator
+WIFI_HAL_INTERFACE_COMBINATIONS := {{{STA}, 1}, {{P2P}, 1}}, {{{STA}, 1}, {{AP}, 1}}
+BOARD_VENDOR_SEPOLICY_DIRS += device/pc/wt20/wifi_ap/sepolicy
+endif
+
+# WT20_HW_VIDEO_DECODE (device/pc/wt20/options.mk, apply17c): SELinux for the FFmpeg VA-API
+# Codec2 HAL (mediacodec domain: binder, its label, the kill-switch property)
+ifeq ($(WT20_HW_VIDEO_DECODE),true)
+BOARD_VENDOR_SEPOLICY_DIRS += device/pc/wt20/media/sepolicy
+endif
+
+# WT20_PERF_HUD (device/pc/wt20/options.mk, apply18a): SELinux for the WT20 HUD app, system_ext
+# private policy: platform_app may read /proc/stat, /proc/meminfo, cpufreq, the thermal zones,
+# the i915 GPU counters and the battery's power_supply files
+ifeq ($(WT20_PERF_HUD),true)
+SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += device/pc/wt20/apps/PerfHud/sepolicy
+endif
diff --git a/bootmgr/grub/grub-boot.cfg b/bootmgr/grub/grub-boot.cfg
index 3a96017..fb551ac 100644
--- a/bootmgr/grub/grub-boot.cfg
+++ b/bootmgr/grub/grub-boot.cfg
@@ -20,6 +20,18 @@ function set_kernel_cmdline_dynamic_device_specific {
 	else
 		set gfxpayload=auto
 	fi
+
+	# Models whose Intel GPU needs the pre-Skylake workarounds get them on every entry (the
+	# plain one gave a black screen). Toshiba Portege WT20-B: Broadwell HD 5300. All of
+	# them: with hardware planes enabled i915 rejects drm_hwcomposer's test commits every
+	# frame and the screen flickers black.
+	insmod smbios
+	insmod regexp
+	set system_product=
+	smbios --type 1 --get-string 5 --set system_product
+	if regexp 'WT20' "$system_product"; then
+		set kernel_cmdline_dynamic_device_specific="androidboot.gpu=intel androidboot.gpu_workaround=all androidboot.hardware_vulkan=intel_hasvk"
+	fi
 }
 
 submenu 'Advanced options (pc_x86_64 specific)' --class format-list-bulleted --id advancedoptions-pc_x86_64 {
@@ -32,3 +44,54 @@ submenu 'Advanced options (pc_x86_64 specific)' --class format-list-bulleted --i
 		boot_android androidboot.graphics=swiftshader
 	}
 }
+
+# Toshiba Portege WT20-B: a tablet with no keyboard, so no boot menu to wait on. Boot straight
+# into Android unless a timeout was saved in grubenv (GRUB settings menu, or Android writing
+# grub_timeout to /mnt/vendor/persist/grubenv). Runs after the common config set the timeout.
+insmod smbios
+insmod regexp
+smbios --type 1 --get-string 5 --set wt20_product
+if regexp 'WT20' "$wt20_product"; then
+	if [ -z "$grub_timeout" ]; then
+		set timeout=0
+	fi
+fi
+
+# Dual boot (apply20a): Windows on the same disk as Android, each with its own EFI partition.
+# The entry only exists when Windows' boot manager is found in one of the first partitions of
+# the Android disk (its EFI system partition), so nothing changes on a single-OS install.
+set wt20_windows_esp=
+set wt20_windows_root=
+for wt20_part in gpt1 gpt2 gpt3 gpt4; do
+	if [ -z "$wt20_windows_esp" ]; then
+		if [ -f (${disk_boot},${wt20_part})/EFI/Microsoft/Boot/bootmgfw.efi ]; then
+			set wt20_windows_esp="(${disk_boot},${wt20_part})"
+			set wt20_windows_root="${disk_boot},${wt20_part}"
+		fi
+	fi
+done
+export wt20_windows_esp
+export wt20_windows_root
+if [ -n "$wt20_windows_esp" ]; then
+	insmod chain
+	menuentry "Windows" --class windows --id windows {
+		echo 'Starting Windows...'
+		# the chainloader gives the started image the ROOT device as its boot device (that is
+		# where Windows Boot Manager looks for its BCD), not the device in the file name
+		set root=${wt20_windows_root}
+		chainloader /EFI/Microsoft/Boot/bootmgfw.efi
+	}
+	# Two systems: show the menu for 5 seconds (Volume keys move, Power selects) unless a
+	# timeout was saved, then boot the default one, Android
+	if [ -z "$grub_timeout" ]; then
+		set timeout=5
+	fi
+	# "Restart into Windows" from Android (wt20_next_os=windows in grubenv): Windows, once
+	set wt20_next_os=
+	load_env -f ${partition_persist}/grubenv wt20_next_os
+	if [ "$wt20_next_os" = "windows" ]; then
+		save_setting wt20_next_os
+		set default=windows
+		set timeout=0
+	fi
+fi
