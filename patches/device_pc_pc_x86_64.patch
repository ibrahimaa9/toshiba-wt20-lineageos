 # Laptop backlights (amdgpu_bl0, intel_backlight, acpi_video0, ...): the lights HAL runs as
 # system. ueventd matches the pattern against /sys/class/backlight/<name>, whatever the name.
 /sys/class/backlight/*    brightness    0664    system    system
+# IIO sensor devices (WT20 sensor hub): the sensors HAL runs as system
+/dev/iio:device*          0660    system    system
