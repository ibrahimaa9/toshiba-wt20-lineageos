+// Planes whose "zpos" is absent or immutable keep the hardware stacking
+// (primary at the bottom, overlays above it, cursor on top): DrmPlane never
+// writes such a zpos, so the planner has to honour that order.
+bool PlanesHaveFixedZOrder(const HwcDisplay* display) {
+  const auto planes = display->GetPipe().GetUsablePlanes().first;
+  return std::any_of(planes.begin(), planes.end(), [](const auto& plane) {
+    const auto& zpos = plane->Get()->GetZPosProperty();
+    return !zpos || zpos.IsImmutable();
+  });
+}
+
+// Whether every usable plane can alpha-blend: a "pixel blend mode" property
+// and alpha bits kept in the framebuffers. Intel pre-Skylake has neither, and
+// avoid_using_alpha_bits_for_framebuffer strips the alpha channel anyway.
+bool PlanesCanBlend(const HwcDisplay* display) {
+  if (Properties::ShouldAvoidUsingAlphaBitsForFramebuffer()) {
+    return false;
+  }
+  const auto planes = display->GetPipe().GetUsablePlanes().first;
+  return std::all_of(planes.begin(), planes.end(), [](const auto& plane) {
+    return plane->Get()->HasBlendProperty();
+  });
+}
+
+// Layers that only look right when blended over what is below them
+bool NeedsBlending(const HwcLayer* layer) {
+  const auto& ld = layer->GetLayerData();
+  return ld.pi.alpha != kAlphaOpaque ||
+         (ld.bi && ld.bi->blend_mode != BufferBlendMode::kNone);
+}
