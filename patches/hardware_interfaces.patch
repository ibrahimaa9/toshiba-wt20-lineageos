+ndk::ScopedAStatus ModulePrimary::populateConnectedDevicePort(AudioPort* audioPort,
+                                                              int32_t nextPortId) {
+    // Analog jack devices (wired headset / headphones and the headset microphone) play and
+    // record through the same ALSA PCM as the speaker / built-in mic (see StreamPrimary): HD
+    // Audio codecs mute the speaker and switch to the jack microphone themselves. There is
+    // nothing to probe: the port keeps its dynamic profiles and the routable mix ports' static
+    // profiles are used, as for the speaker. The base class refuses all external devices.
+    if (audioPort->ext.getTag() == AudioPortExt::device &&
+        audioPort->ext.get<AudioPortExt::device>().device.type.connection ==
+                AudioDeviceDescription::CONNECTION_ANALOG) {
+        return ndk::ScopedAStatus::ok();
+    }
+#ifdef WT20_HDMI_AUDIO
+    // HDMI / DisplayPort (HD Audio HDMI codec): the "hdmi output" mix port's static profile is
+    // used, and StreamPrimary finds the ALSA PCM of the plugged port. Without WT20_HDMI_AUDIO
+    // the connection is refused as before, so the policy keeps sound on the speaker / jack.
+    if (audioPort->ext.getTag() == AudioPortExt::device &&
+        audioPort->ext.get<AudioPortExt::device>().device.type.connection ==
+                AudioDeviceDescription::CONNECTION_HDMI) {
+        return ndk::ScopedAStatus::ok();
+    }
+#endif
+    return Module::populateConnectedDevicePort(audioPort, nextPortId);
+}
