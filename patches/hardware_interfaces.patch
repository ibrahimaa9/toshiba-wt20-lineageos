 namespace aidl::android::hardware::audio::core {
 
+namespace {
+
+// Whether the device's address names an ALSA card / device ("CARD_<n>_DEV_<m>", see
+// StreamPrimary::getCardAndDeviceId)
+bool namesAlsaDevice(const AudioDevice& device) {
+    return device.address.getTag() == AudioDeviceAddress::id &&
+           device.address.get<AudioDeviceAddress::id>().find("CARD_") != std::string::npos;
+}
+
+// An HDMI / DisplayPort output that names no ALSA device (the framework connects HDMI with an
+// empty address): it plays on the HD Audio HDMI card (findHdmiAlsaDevice)
+bool isHdmiOutput(bool isInput, const AudioDevice& device) {
+    return !isInput && device.type.connection == AudioDeviceDescription::CONNECTION_HDMI &&
+           !namesAlsaDevice(device);
+}
+
+// Whether the device uses the default ALSA card / device: its address names none, and it is
+// not HDMI (another card)
+bool usesDefaultAlsaDevice(const AudioDevice& device) {
+    return !namesAlsaDevice(device) &&
+           device.type.connection != AudioDeviceDescription::CONNECTION_HDMI;
+}
+
+constexpr int kMaxAlsaCards = 8;
+
+// The HDMI / DisplayPort PCM to play on. snd-hda-codec-hdmi names one jack control per PCM,
+// "HDMI/DP,pcm=<device> Jack", which reads 1 while a monitor that takes audio (valid ELD) is
+// connected to the port behind that PCM (PCMs follow the ports dynamically on Intel display
+// audio). Returns the card and device of the first plugged jack, else the HDMI card's first
+// PCM, or nothing when no card has HDMI jacks.
+std::optional<std::pair<int, int>> findHdmiAlsaDevice() {
+    std::optional<std::pair<int, int>> firstPcm;
+    for (int card = 0; card < kMaxAlsaCards; ++card) {
+        if (access(StringPrintf("/dev/snd/controlC%d", card).c_str(), F_OK) != 0) continue;
+        struct mixer* mixer = mixer_open(card);
+        if (mixer == nullptr) continue;
+        std::optional<std::pair<int, int>> plugged;
+        const unsigned int ctlCount = mixer_get_num_ctls(mixer);
+        for (unsigned int i = 0; i < ctlCount && !plugged.has_value(); ++i) {
+            const struct mixer_ctl* ctl = mixer_get_ctl(mixer, i);
+            const char* name = ctl != nullptr ? mixer_ctl_get_name(ctl) : nullptr;
+            int device = -1;
+            char suffix[8] = {};
+            if (name == nullptr || sscanf(name, "HDMI/DP,pcm=%d %7s", &device, suffix) != 2 ||
+                strcmp(suffix, "Jack") != 0 ||
+                access(StringPrintf("/dev/snd/pcmC%dD%dp", card, device).c_str(), F_OK) != 0) {
+                continue;
+            }
+            if (!firstPcm.has_value()) firstPcm = std::make_pair(card, device);
+            if (mixer_ctl_get_value(ctl, 0) > 0) plugged = std::make_pair(card, device);
+        }
+        mixer_close(mixer);
+        if (plugged.has_value()) {
+            LOG(DEBUG) << __func__ << ": HDMI card " << plugged->first << " device "
+                       << plugged->second << " is plugged";
+            return plugged;
+        }
+    }
+    if (!firstPcm.has_value()) {
+        LOG(WARNING) << __func__ << ": no HDMI / DisplayPort PCM found";
+    }
+    return firstPcm;
+}
