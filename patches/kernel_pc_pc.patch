 }
 
 static void pch_disable_backlight(const struct drm_connector_state *old_conn_state, u32 val)
@@ -1212,6 +1227,82 @@ static u32 get_backlight_min_vbt(struct intel_connector *connector)
 	return scale(min, 0, 255, 0, panel->backlight.pwm_level_max);
 }
 
+/*
+ * Toshiba Portege WT20-B (Broadwell-Y, Wildcat Point-LP PCH): the firmware
+ * programs the PCH PWM with the default 128-clock increment and a period of 18
+ * increments (24 MHz / (18 * 128) = ~10.4 kHz), so the backlight has only 18
+ * steps and Android's brightness slider moves in visible jumps.
+ *
+ * With i915.wt20_fine_backlight=1, switch to the alternate 16-clock increment
+ * (SOUTH_CHICKEN2 LPT_PWM_GRANULARITY) and multiply the period by 8: the PWM
+ * frequency the panel sees stays the same, and the period and duty cycle get
+ * 8 times as many steps (144). A duty cycle the firmware left running is
+ * scaled the same way, so the brightness does not change at the switch.
+ * lpt_disable_backlight() puts the firmware's increment and period back.
+ *
+ * Off by default. Only on the WT20 (DMI), only when the firmware left the
+ * default increment and its own period in BLC_PWM_PCH_CTL2 (not the VBT
+ * fallback), and not when the CPU PWM was in use.
+ */
+#define LPT_FINE_BACKLIGHT_MUL	8	/* 128-clock / 16-clock increment */
+
+static bool wt20_fine_backlight;
+module_param(wt20_fine_backlight, bool, 0400);
+MODULE_PARM_DESC(wt20_fine_backlight,
+		 "Toshiba Portege WT20: 8x finer PCH PWM backlight steps at the same PWM frequency (default: false)");
+
+static const struct dmi_system_id lpt_fine_backlight_dmi_table[] = {
+	{
+		/* Toshiba Portege WT20-B: firmware PWM period 18, 128-clock increment */
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "TOSHIBA"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "PORTEGE WT20"),
+		},
+	},
+	{}
+};
+
+static void lpt_fine_backlight_setup(struct intel_connector *connector,
+				     enum pipe pipe, u32 pch_ctl1, u32 hw_max)
+{
+	struct drm_i915_private *i915 = to_i915(connector->base.dev);
+	struct intel_panel *panel = &connector->panel;
+	u32 fw_max = panel->backlight.pwm_level_max;
+	u32 fine_max = fw_max * LPT_FINE_BACKLIGHT_MUL;
+	u32 duty;
+
+	if (!wt20_fine_backlight || !dmi_check_system(lpt_fine_backlight_dmi_table))
+		return;
+
+	if (!HAS_PCH_LPT(i915) || !fw_max || hw_max != fw_max ||
+	    fine_max > BACKLIGHT_DUTY_CYCLE_MASK) {
+		drm_info(&i915->drm,
+			 "[CONNECTOR:%d:%s] WT20 fine backlight steps not used (PWM period %u, firmware %u)\n",
+			 connector->base.base.id, connector->base.name, fw_max, hw_max);
+		return;
+	}
+
+	if (pch_ctl1 & BLM_PCH_PWM_ENABLE) {
+		/*
+		 * Period and duty cycle are one register, so the duty ratio is
+		 * the same before and after each of the two writes.
+		 */
+		duty = min(lpt_get_backlight(connector, pipe), fw_max);
+		intel_de_write(i915, BLC_PWM_PCH_CTL2,
+			       (fine_max << 16) | (duty * LPT_FINE_BACKLIGHT_MUL));
+		intel_de_rmw(i915, SOUTH_CHICKEN2, 0, LPT_PWM_GRANULARITY);
+	}
+
+	panel->backlight.fw_pwm_level_max = fw_max;
+	panel->backlight.alternate_pwm_increment = true;
+	panel->backlight.pwm_level_max = fine_max;
+	panel->backlight.pwm_level_min = get_backlight_min_vbt(connector);
+
+	drm_info(&i915->drm,
+		 "[CONNECTOR:%d:%s] WT20 fine backlight steps: PWM period %u -> %u (16-clock increment)\n",
+		 connector->base.base.id, connector->base.name, fw_max, fine_max);
+}
+
 static int lpt_setup_backlight(struct intel_connector *connector, enum pipe unused)
 {
 	struct drm_i915_private *i915 = to_i915(connector->base.dev);
@@ -1262,6 +1353,9 @@ static int lpt_setup_backlight(struct intel_connector *connector, enum pipe unus
 			       cpu_ctl2 & ~BLM_PWM_ENABLE);
 	}
 
+	if (!alt && !cpu_mode)
+		lpt_fine_backlight_setup(connector, unused, pch_ctl1, pch_ctl2 >> 16);
+
 	drm_dbg_kms(&i915->drm,
 		    "[CONNECTOR:%d:%s] Using native PCH PWM for backlight control\n",
 		    connector->base.base.id, connector->base.name);
