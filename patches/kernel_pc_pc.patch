 #define to_acpi_battery(x) power_supply_get_drvdata(x)
@@ -1067,6 +1075,59 @@ static void acpi_battery_refresh(struct acpi_battery *battery)
 }
 
 /* Driver Interface */
+/* Charge percent as user space sees it, -1 if unknown */
+static int acpi_battery_percent(struct acpi_battery *battery)
+{
+	int full = ACPI_BATTERY_VALUE_UNKNOWN;
+
+	if (ACPI_BATTERY_CAPACITY_VALID(battery->full_charge_capacity))
+		full = battery->full_charge_capacity;
+	else if (ACPI_BATTERY_CAPACITY_VALID(battery->design_capacity))
+		full = battery->design_capacity;
+	if (battery->capacity_now == ACPI_BATTERY_VALUE_UNKNOWN ||
+	    full == ACPI_BATTERY_VALUE_UNKNOWN || full == 0)
+		return -1;
+	return battery->capacity_now * 100 / full;
+}
+
+/*
+ * battery_skip_unchanged_status: some ECs (Toshiba Portege WT20-B) send a status-change
+ * notification every couple of seconds whether anything changed or not. Each forwarded one is
+ * a uevent plus an ACPI netlink event, i.e. a wakeup event, so such a machine can never stay
+ * suspended. Forward a status notification only when the charge state, presence or percent
+ * changed, or a minute after the last one so energy and rate readings still refresh.
+ */
+static bool acpi_battery_status_unchanged(struct acpi_battery *battery, u32 event)
+{
+	int percent = acpi_battery_percent(battery);
+	int present = acpi_battery_present(battery);
+
+	if (!battery_skip_unchanged_status || event != ACPI_BATTERY_NOTIFY_STATUS)
+		return false;
+	/*
+	 * In suspend-to-idle (this then runs from the in-band dispatch of the
+	 * firmware event GPE, see s2idle_event_gpe in sleep.c) forward only a
+	 * change of charge state or presence: a forwarded notification calls
+	 * power_supply_changed(), a wakeup event, so a percent step or the
+	 * one-minute refresh would resume the system for nothing. They go out
+	 * with the first notification after resume. A critical battery still
+	 * wakes the system from acpi_battery_update(), and the critical bit is
+	 * part of the state.
+	 */
+	if (battery->notified_time &&
+	    battery->state == battery->notified_state &&
+	    present == battery->notified_present &&
+	    (acpi_s2idle_wakeup() ||
+	     (percent == battery->notified_percent &&
+	      time_before(jiffies, battery->notified_time + 60 * HZ))))
+		return true;
+	battery->notified_state = battery->state;
+	battery->notified_percent = percent;
+	battery->notified_present = present;
+	battery->notified_time = jiffies;
+	return false;
+}
+
 static void acpi_battery_notify(acpi_handle handle, u32 event, void *data)
 {
 	struct acpi_device *device = data;
@@ -1090,6 +1151,8 @@ static void acpi_battery_notify(acpi_handle handle, u32 event, void *data)
 	if (event == ACPI_BATTERY_NOTIFY_INFO)
 		acpi_battery_refresh(battery);
 	acpi_battery_update(battery, false);
+	if (acpi_battery_status_unchanged(battery, event))
+		return;
 	acpi_bus_generate_netlink_event(device->pnp.device_class,
 					dev_name(&device->dev), event,
 					acpi_battery_present(battery));
@@ -1153,6 +1216,13 @@ battery_ac_is_broken_quirk(const struct dmi_system_id *d)
 	return 0;
 }
 
+static int __init
+battery_skip_unchanged_status_quirk(const struct dmi_system_id *d)
+{
