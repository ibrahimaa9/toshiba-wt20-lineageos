@@ -355,6 +358,18 @@ static void lpt_disable_backlight(const struct drm_connector_state *old_conn_sta
 	}
 
 	intel_de_rmw(i915, BLC_PWM_PCH_CTL1, BLM_PCH_PWM_ENABLE, 0);
+
+	/*
+	 * WT20 fine backlight steps (see lpt_fine_backlight_setup()): with the
+	 * PWM off, give the firmware its increment and period back, so that the
+	 * firmware after a reboot, or a kernel without the option, finds the
