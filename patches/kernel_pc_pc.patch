+	 */
+	if (panel->backlight.fw_pwm_level_max) {
+		intel_de_rmw(i915, SOUTH_CHICKEN2, LPT_PWM_GRANULARITY, 0);
+		intel_de_write(i915, BLC_PWM_PCH_CTL2,
