+
 /*
  * The ACPI specification wants us to save NVS memory regions during hibernation
  * and to restore them during the subsequent resume.  Windows does that also for
@@ -755,6 +761,70 @@ int acpi_s2idle_prepare(void)
 	return 0;
 }
 
+/*
+ * s2idle_event_gpe: GPE through which the firmware reports EC events on a
+ * platform without an ACPI EC device, or U32_MAX for none.
+ *
+ * The Toshiba Portege WT20-B has no ACPI EC (no PNP0C09 device, no ECDT). Its
+ * firmware services the embedded controller in SMM, leaves event flags in
+ * memory and raises the PCH software GPE (0x62, SWGPE); _L62 then Notify()s
+ * the AC adapter, the batteries, the lid, the thermal zone and the Toshiba
+ * VALZ device as those flags say. The EC raises it about every 1.7 s with a
+ * battery status that has not changed. PNP0C0C's _PRW names GPE 0x62, so it
+ * stays enabled in suspend-to-idle, and with no EC acpi_ec_dispatch_gpe()
+ * takes any enabled GPE status bit as a wakeup: the system went back to a
+ * full resume within ~2 s of every suspend.
+ */
+static u32 s2idle_event_gpe = U32_MAX;
+
+static int __init s2idle_event_gpe_quirk(const struct dmi_system_id *d)
+{
+	s2idle_event_gpe = (u32)(unsigned long)d->driver_data;
+	return 0;
+}
+
+static const struct dmi_system_id s2idle_event_gpe_dmi_table[] __initconst = {
+	{
+		/* Toshiba Portege WT20-B: EC events via the software GPE, _L62 */
+		.callback = s2idle_event_gpe_quirk,
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "TOSHIBA"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "PORTEGE WT20"),
+		},
+		.driver_data = (void *)0x62,
+	},
+	{}
+};
+
+/*
+ * Check the GPEs after an SCI wakeup from suspend-to-idle. Normally that is
+ * acpi_ec_dispatch_gpe(). With s2idle_event_gpe, treat that GPE the way
+ * acpi_ec_dispatch_gpe() treats the EC GPE: a status bit set for any other
+ * enabled GPE is a wakeup; otherwise cancel the SCI wakeup and dispatch the
+ * GPE in-band (its _Lxx method is queued as from the SCI handler).
+ * acpi_s2idle_wake() then waits for the method and the Notify() handlers it
+ * queued (acpi_os_wait_events_complete()) and resumes only if one of them
+ * reported a wakeup event (lid opened: button.c; battery critical:
+ * battery.c; adapter plugged or unplugged: ac.c). Fixed events, so the fixed
+ * power button, are checked before this and are not affected. Should an ACPI
+ * EC show up after all, its GPE is handled the normal way.
+ */
+static bool acpi_s2idle_dispatch_gpe(void)
+{
+	if (s2idle_event_gpe == U32_MAX || first_ec)
+		return acpi_ec_dispatch_gpe();
+
+	if (acpi_any_gpe_status_set(s2idle_event_gpe))
+		return true;
+
+	pm_system_cancel_wakeup();
+
+	if (acpi_dispatch_gpe(NULL, s2idle_event_gpe) == ACPI_INTERRUPT_HANDLED)
+		pm_pr_dbg("ACPI event GPE %02X dispatched\n", s2idle_event_gpe);
+
+	return false;
+}
+
 bool acpi_s2idle_wake(void)
 {
 	if (!acpi_sci_irq_valid())
@@ -789,9 +859,10 @@ bool acpi_s2idle_wake(void)
 
 		/*
 		 * Check non-EC GPE wakeups and if there are none, cancel the
-		 * SCI-related wakeup and dispatch the EC GPE.
+		 * SCI-related wakeup and dispatch the EC GPE (or the firmware
+		 * event GPE, see s2idle_event_gpe).
 		 */
-		if (acpi_ec_dispatch_gpe()) {
+		if (acpi_s2idle_dispatch_gpe()) {
 			pm_pr_dbg("ACPI non-EC GPE wakeup\n");
 			return true;
 		}
@@ -876,6 +947,7 @@ static void __init acpi_sleep_suspend_setup(void)
 		suspend_set_ops(old_suspend_ordering ?
 				&acpi_suspend_ops_old : &acpi_suspend_ops);
 
+	dmi_check_system(s2idle_event_gpe_dmi_table);
 	acpi_s2idle_setup();
 }
 
