diff --git a/bootmgr/grub/grub-boot.cfg b/bootmgr/grub/grub-boot.cfg
index 7c0fa39..bda5256 100644
--- a/bootmgr/grub/grub-boot.cfg
+++ b/bootmgr/grub/grub-boot.cfg
@@ -30,18 +30,21 @@ insmod regexp
 set esp_disk=
 regexp --set=1:esp_disk '^(hd[0-9]+),' "$root"
 
-# PERSIST is partition 4 (A/B) or 9 of the disk Android is installed on. Only those partitions
-# are checked: searching every device for the label hangs GRUB on some PC firmwares (tablets
-# with 32-bit UEFI).
+# PERSIST is partition 4 (A/B) or 9 of the disk Android is installed on, or 24 when Android
+# was installed next to another system (dual boot: the A/B numbers + 20, see
+# pc_create_partition_table.sh). Only those partitions are checked: searching every device for
+# the label hangs GRUB on some PC firmwares (tablets with 32-bit UEFI).
 insmod probe
 set partition_persist=
+set persist_gpt=
 for persist_disk in ${esp_disk} hd0 hd1 hd2 hd3 hd4 hd5 hd6 hd7; do
-	for persist_part in gpt4 gpt9; do
+	for persist_part in gpt4 gpt9 gpt24; do
 		if [ -z "$partition_persist" ]; then
 			set persist_label=
 			if probe --set=persist_label --label (${persist_disk},${persist_part}); then
 				if [ "$persist_label" = "PERSIST" ]; then
 					set partition_persist="(${persist_disk},${persist_part})"
+					set persist_gpt="${persist_part}"
 				fi
 			fi
 		fi
@@ -59,11 +62,20 @@ fi
 export disk_boot
 
 if [ "$ab_enable" = "true" ]; then
-	set partition_boot_a="(${disk_boot},gpt9)"
-	set partition_boot_b="(${disk_boot},gpt10)"
-	set partition_misc="(${disk_boot},gpt3)"
-	set partition_vendor_boot_a="(${disk_boot},gpt7)"
-	set partition_vendor_boot_b="(${disk_boot},gpt8)"
+	if [ "$persist_gpt" = "gpt24" ]; then
+		# Dual boot: the A/B partition numbers + 20
+		set partition_boot_a="(${disk_boot},gpt29)"
+		set partition_boot_b="(${disk_boot},gpt30)"
+		set partition_misc="(${disk_boot},gpt23)"
+		set partition_vendor_boot_a="(${disk_boot},gpt27)"
+		set partition_vendor_boot_b="(${disk_boot},gpt28)"
+	else
+		set partition_boot_a="(${disk_boot},gpt9)"
+		set partition_boot_b="(${disk_boot},gpt10)"
+		set partition_misc="(${disk_boot},gpt3)"
+		set partition_vendor_boot_a="(${disk_boot},gpt7)"
+		set partition_vendor_boot_b="(${disk_boot},gpt8)"
+	fi
 	export partition_boot_a
 	export partition_boot_b
 	export partition_vendor_boot_a
