<resources>
    <string name="app_name">WT20 HUD</string>
    <string name="intro">A small panel that stays on top of everything, games included: frames, CPU, GPU, temperatures, memory and battery. Drag it where you like, then lock it so touches go to the game.</string>
    <string name="show_hud">Show the HUD</string>
    <string name="start_failed">Android did not let the HUD start (log: WT20Hud).</string>

    <string name="window_secure">On top of everything, the status bar included.</string>
    <string name="window_system">On top of everything; you can drag it now.</string>
    <string name="window_overlay">Shown as a normal overlay above the apps (the status bar can cover it).</string>
    <string name="window_none">The HUD could not be shown (log: WT20Hud).</string>

    <string name="section_metrics">What to show</string>
    <string name="metric_fps">FPS: frames shown per second</string>
    <string name="metric_cpu">CPU: total load</string>
    <string name="metric_cpu_cores">CPU: load of each core</string>
    <string name="metric_cpu_freq">FRQ: clock of each core (GHz)</string>
    <string name="metric_cpu_temp">TMP: CPU temperature</string>
    <string name="metric_board_temp">TMP: board temperature (BRD; fixed at 16 degrees on this tablet)</string>
    <string name="metric_gpu_freq">GPU: clock (MHz)</string>
    <string name="metric_gpu_load">GPU: load</string>
    <string name="metric_ram">RAM: memory used</string>
    <string name="metric_swap">RAM: swap used (SWP)</string>
    <string name="metric_battery">BAT: battery level and charging</string>
    <string name="metric_battery_power">BAT: power in watts (+ charging, - discharging)</string>
    <string name="metric_clock">CLK: clock</string>
    <string name="fps_note">FPS counts the frames the screen really shows: a still screen reads low, that is normal.</string>

    <string name="section_position">Position</string>
    <string name="lock">Lock position</string>
    <string name="lock_note">While it is locked, touches pass through it to the game. Unlock it to drag the HUD anywhere, then lock it again.</string>
    <string name="reset_position">Reset position</string>

    <string name="section_size">Text size</string>
    <string name="size_small">Small</string>
    <string name="size_medium">Medium</string>
    <string name="size_large">Large</string>
    <string name="section_opacity">Background opacity</string>
    <string name="percent">%1$d%%</string>
    <string name="section_interval">Update every</string>
    <string name="interval_half">0.5 s</string>
    <string name="interval_one">1 s</string>
    <string name="interval_two">2 s</string>

    <string name="channel_name">HUD</string>
    <string name="notification_title">The HUD is on</string>
    <string name="notification_text">Tap for its settings</string>
    <string name="hide">Hide</string>
    <string name="tile_on">Shown</string>
    <string name="tile_off">Hidden</string>
</resources>
