<?xml version="1.0" encoding="utf-8"?>
<!--
     Toshiba Portege WT20-B: adaptive brightness from the HID sensor hub's ambient light sensor
     (reports lux directly). The backlight costs up to ~1.8 W between low and full brightness.
-->
<resources>
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Ambient light thresholds (lux); backlight values below have one entry more -->
    <integer-array name="config_autoBrightnessLevels">
        <item>2</item>
        <item>5</item>
        <item>10</item>
        <item>20</item>
        <item>40</item>
        <item>80</item>
        <item>150</item>
        <item>300</item>
        <item>600</item>
        <item>1200</item>
        <item>2500</item>
        <item>5000</item>
    </integer-array>

    <!-- Backlight 0-255 for each range: below 2 lux, 2-5 lux, ..., above 5000 lux -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>10</item>
        <item>18</item>
        <item>28</item>
        <item>40</item>
        <item>55</item>
        <item>72</item>
        <item>95</item>
        <item>120</item>
        <item>150</item>
        <item>180</item>
        <item>210</item>
        <item>238</item>
        <item>255</item>
    </integer-array>

    <!-- The 3.5 mm headset jack: the kernel reports it through ALSA's jack input devices
         ("HDA Intel PCH Headphone" SW_HEADPHONE_INSERT, "HDA Intel PCH Mic"
         SW_MICROPHONE_INSERT), not through the h2w switch uevent the default expects -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Large screen: phone apps locked to portrait can be set fullscreen or to another
         aspect ratio per app (Settings > Apps > Aspect ratio), and letterboxed apps can be
         moved with a double tap -->
    <bool name="config_appCompatUserAppAspectRatioSettingsIsEnabled">true</bool>
    <bool name="config_appCompatUserAppAspectRatioFullscreenIsEnabled">true</bool>
    <bool name="config_letterboxIsHorizontalReachabilityEnabled">true</bool>
    <bool name="config_letterboxIsEducationEnabled">true</bool>
    <bool name="config_isCompatFakeFocusEnabled">true</bool>
    <bool name="config_letterboxIsSplitScreenAspectRatioForUnresizableAppsEnabled">true</bool>

    <!-- Portrait-only camera apps get an upright preview on this landscape tablet -->
    <bool name="config_isWindowManagerCameraCompatTreatmentEnabled">true</bool>

    <!-- Screen saver when the screen times out on the charger (no dock signal exists) -->
    <bool name="config_dreamsActivatedOnSleepByDefault">true</bool>

    <!-- Time zone from location: no modem, so the GeoTZ offline provider is the only source -->
    <bool name="config_enablePrimaryLocationTimeZoneProvider">true</bool>
    <string name="config_primaryLocationTimeZoneProviderPackageName" translatable="false">com.android.timezone.location.provider</string>
</resources>
