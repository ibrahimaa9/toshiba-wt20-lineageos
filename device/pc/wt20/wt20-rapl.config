# Toshiba Portege WT20-B (apply15m, options.mk WT20_RAPL): Intel RAPL through the MSR interface.
# /sys/class/powercap/intel-rapl:0 (package-0) with its core / uncore subzones: energy counters
# (energy_uj, root only) and the package power limits PL1/PL2 the firmware set. Nothing writes
# the limits; this is for measuring power-HAL boosts and games.
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=y
