# Toshiba Portege WT20-B (Broadwell-Y Core M-5Y10c tablet), on top of pc.config.

# Bluetooth power switch (ACPI TOS6205). The Intel 8087:0A2A adapter is kept off until this
# driver turns it on, so without it there's no Bluetooth device on the USB bus at all.
CONFIG_TOSHIBA_BT_RFKILL=y

# ST sensor hub (USB HID 0483:91D1): accelerometer, gyroscope, magnetometer, ambient light,
# inclinometer and device rotation as IIO devices, for the IIO sensors HAL (auto-rotation).
CONFIG_HID_SENSOR_HUB=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_HID_SENSOR_IIO_COMMON=y
CONFIG_HID_SENSOR_IIO_TRIGGER=y
CONFIG_HID_SENSOR_ACCEL_3D=y
CONFIG_HID_SENSOR_GYRO_3D=y
CONFIG_HID_SENSOR_MAGNETOMETER_3D=y
CONFIG_HID_SENSOR_ALS=y
CONFIG_HID_SENSOR_INCLINOMETER_3D=y
CONFIG_HID_SENSOR_DEVICE_ROTATION=y

# CPU temperature: the package thermal zone (x86_pkg_temp) and coretemp for the thermal HAL,
# and the firmware's ACPI thermal zones (passive cooling trip points of the tablet)
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_ACPI_THERMAL=y
