// Generated by gen_ffmpeg_bp.py (WT20 hwdec, installed by apply17a.py) from the FFmpeg 7.1.3
// configure output in wt20/. Do not edit: rerun ffmpeg_configure.sh + gen_ffmpeg_bp.py.
// Source lists: make -n (emulation agrees). LGPL-2.1-or-later build (no --enable-gpl/version3/nonfree).
// Only visible to the build when external/ffmpeg is in PRODUCT_SOONG_NAMESPACES
// (device/pc/wt20, WT20_HW_VIDEO_DECODE).

soong_namespace {
}

package {
    default_applicable_licenses: ["external_ffmpeg_license"],
}

license {
    name: "external_ffmpeg_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-LGPL-2.1-or-later"],
    license_text: ["COPYING.LGPLv2.1"],
}

cc_defaults {
    name: "wt20_ffmpeg_defaults",
    vendor: true,
    compile_multilib: "64",
    enabled: false,
    arch: {
        x86_64: {
            enabled: true,
        },
    },
    c_std: "c17",
    cflags: [
        "-D_ISOC11_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-D_LARGEFILE_SOURCE",
        "-Dstrtod=avpriv_strtod",
        "-DPIC",
        "-DHAVE_AV_CONFIG_H",
        "-fomit-frame-pointer",
        "-fno-math-errno",
        "-fno-signed-zeros",
        "-mstack-alignment=16",
        "-Wno-error",
        "-Wno-unknown-warning-option",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-const-variable",
        "-Wno-unused-label",
        "-Wno-unused-value",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-pointer-sign",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-deprecated-declarations",
        "-Wno-parentheses",
        "-Wno-switch",
        "-Wno-implicit-fallthrough",
        "-Wno-string-plus-int",
        "-Wno-constant-conversion",
        "-Wno-implicit-const-int-float-conversion",
        "-Wno-sometimes-uninitialized",
        "-Wno-uninitialized",
        "-Wno-absolute-value",
        "-Wno-tautological-constant-out-of-range-compare",
        "-Wno-tautological-pointer-compare",
        "-Wno-shift-negative-value",
        "-Wno-format",
        "-Wno-unknown-pragmas",
        "-Wno-asm-operand-widths",
        "-Wno-gnu-folding-constant",
        "-Wno-unused-command-line-argument",
    ],
    local_include_dirs: ["."],
    ldflags: ["-Wl,-Bsymbolic"],
    header_libs: ["libffmpeg_headers"],
}

// The public include root: <libavcodec/avcodec.h>, <libavutil/hwcontext_vaapi.h>, ...
cc_library_headers {
    name: "libffmpeg_headers",
    vendor: true,
    enabled: false,
    arch: {
        x86_64: {
            enabled: true,
        },
    },
    export_include_dirs: ["."],
}

